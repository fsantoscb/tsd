{
  "name": "@tsd/oracle-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "oracle:test": "tsx --env-file=.env src/cli.ts oracle:test",
    "oracle:inspect": "tsx --env-file=.env src/cli.ts oracle:inspect",
    "oracle:machine-load": "tsx scripts/validate-machine-load.ts",
    "sync:once": "tsx --env-file=.env src/cli.ts sync:once",
    "sync:once:run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-once.ps1",
    "audit:backfill": "tsx scripts/backfill-audit.ts",
    "lint": "eslint src __tests__",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tsd/shared": "workspace:*",
    "oracledb": "^6.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/oracledb": "^7.0.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^9.39.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
