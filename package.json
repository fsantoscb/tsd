{
  "name": "tsd-production-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @tsd/web dev",
    "start:web": "pnpm --filter @tsd/web start",
    "sync:once": "pnpm --filter @tsd/oracle-sync sync:once",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^9.17.0",
    "supabase": "^2.117.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
