{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "incremental": true
  },
  "include": [
    "app",
    "components",
    "lib",
    "app/api",
    "__tests__",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
